# Preserve bytes and existing line endings, including UTF-8 text and emojis.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Retain upstream notices byte-for-byte, including their original whitespace.
third-party/** -whitespace
connect/** -whitespace
*.mp3 binary
*.wav binary
*.mdl binary
*.vtx binary
*.vvd binary
*.phy binary
*.vtf binary
*.raw binary
